// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String        @id @default(uuid())
  code            String        @unique @db.NVarChar(100)
  name            String        @db.NVarChar(200)
  trn             String?       @db.NVarChar(50)
  email           String?       @db.NVarChar(200)
  phone           String?       @db.NVarChar(50)
  addressLine1    String?       @db.NVarChar(200)
  addressLine2    String?       @db.NVarChar(200)
  city            String?       @db.NVarChar(100)
  state           String?       @db.NVarChar(100)
  postalCode      String?       @db.NVarChar(50)
  countryCode     String        @default("AE") @db.NVarChar(2)
  aspProvider     String        @default("FAKE") @db.NVarChar(50)
  aspBaseUrl      String?       @db.NVarChar(500)
  aspApiKey       String?       @db.NVarChar(500)
  aspWebhookToken String?       @db.NVarChar(500)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  integrations    Integration[]
  invoices        Invoice[]

  @@map("tenants")
}

model Integration {
  id                 String              @id @default(uuid())
  tenantId           String
  code               String              @db.NVarChar(100)
  name               String              @db.NVarChar(200)
  authType           String              @default("API_KEY_HMAC") @db.NVarChar(50)
  apiKey             String              @db.NVarChar(200)
  apiSecret          String              @db.NVarChar(500)
  webhookUrl         String?             @db.NVarChar(500)
  webhookSecret      String?             @db.NVarChar(500)
  allowedIpRanges    String?             @db.NVarChar(1000)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices           Invoice[]

  @@unique([tenantId, code])
  @@map("integrations")
}

model Invoice {
  id                  String         @id @default(uuid())
  tenantId            String
  integrationId       String
  sourceSystem        String         @db.NVarChar(100)
  sourceDocumentId    String         @db.NVarChar(100)
  idempotencyKey      String         @db.NVarChar(200)
  invoiceNumber       String         @db.NVarChar(100)
  documentType        String         @db.NVarChar(50)
  status              String         @default("DRAFT") @db.NVarChar(50)
  issueDate           DateTime
  currencyCode        String         @default("AED") @db.NVarChar(3)
  sellerName          String         @db.NVarChar(200)
  sellerTrn           String?        @db.NVarChar(50)
  sellerAddressLine1  String?        @db.NVarChar(200)
  sellerAddressLine2  String?        @db.NVarChar(200)
  sellerCity          String?        @db.NVarChar(100)
  sellerState         String?        @db.NVarChar(100)
  sellerPostalCode    String?        @db.NVarChar(50)
  sellerCountryCode   String         @default("AE") @db.NVarChar(100)
  buyerName           String         @db.NVarChar(200)
  buyerTrn            String?        @db.NVarChar(50)
  buyerAddressLine1   String?        @db.NVarChar(200)
  buyerAddressLine2   String?        @db.NVarChar(200)
  buyerCity           String?        @db.NVarChar(100)
  buyerState          String?        @db.NVarChar(100)
  buyerPostalCode     String?        @db.NVarChar(50)
  buyerCountryCode    String         @default("AE") @db.NVarChar(100)
  subtotalAmount      Decimal        @db.Decimal(18, 2)
  taxAmount           Decimal        @db.Decimal(18, 2)
  totalAmount         Decimal        @db.Decimal(18, 2)
  notes               String?        @db.NVarChar(1000)
  aspMessageId        String?        @db.NVarChar(100)
  aspReferenceId      String?        @db.NVarChar(100)
  aspPayload          String?        @db.NVarChar(Max)
  aspResponse         String?        @db.NVarChar(Max)
  submissionAttempts  Int            @default(0)
  lastSubmissionError String?        @db.NVarChar(2000)
  lastSubmissionAt    DateTime?
  rejectionReason     String?        @db.NVarChar(2000)
  submittedAt         DateTime?
  acceptedAt          DateTime?
  rejectedAt          DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  integration         Integration    @relation(fields: [integrationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines               InvoiceLine[]
  events              InvoiceEvent[]

  @@unique([tenantId, sourceSystem, sourceDocumentId, documentType])
  @@unique([tenantId, integrationId, idempotencyKey])
  @@unique([tenantId, invoiceNumber, documentType])
  @@index([tenantId, status])
  @@index([integrationId, sourceDocumentId])
  @@map("invoices")
}

model InvoiceLine {
  id               String   @id @default(uuid())
  invoiceId        String
  lineNumber       Int
  description      String   @db.NVarChar(500)
  quantity         Decimal  @db.Decimal(18, 4)
  unitPrice        Decimal  @db.Decimal(18, 2)
  netAmount        Decimal  @db.Decimal(18, 2)
  vatRate          Decimal  @db.Decimal(5, 2)
  vatCategory      String   @db.NVarChar(20)
  taxAmount        Decimal  @db.Decimal(18, 2)
  totalAmount      Decimal  @db.Decimal(18, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, lineNumber])
  @@map("invoice_lines")
}

model InvoiceEvent {
  id            String      @id @default(uuid())
  invoiceId     String
  type          String       @db.NVarChar(50)
  fromStatus    String?      @db.NVarChar(50)
  toStatus      String?      @db.NVarChar(50)
  message       String      @db.NVarChar(1000)
  payload       String?     @db.NVarChar(Max)
  createdAt     DateTime    @default(now())
  invoice       Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
  @@map("invoice_events")
}

model WebhookDelivery {
  id              String   @id @default(uuid())
  integrationId   String
  invoiceId       String
  event           String   @db.NVarChar(100)
  payload         String   @db.NVarChar(Max)
  status          String   @default("PENDING") @db.NVarChar(50)
  attempts        Int      @default(0)
  lastError       String?  @db.NVarChar(2000)
  responseCode    Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@index([invoiceId, createdAt])
  @@map("webhook_deliveries")
}
