generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String        @id @default(uuid()) @db.NVarChar(250)
  code            String        @unique @db.NVarChar(100)
  name            String        @db.NVarChar(200)
  trn             String?       @db.NVarChar(50)
  email           String?       @db.NVarChar(200)
  /** @deprecated Prefer AspConnection via LegalEntity. Kept for migration compatibility. */
  aspProvider     String        @db.NVarChar(50)
  /** @deprecated Prefer AspConnection / AspProviderApiConfig. */
  aspBaseUrl      String?       @db.NVarChar(500)
  /** @deprecated Prefer AspCredential on AspConnection. */
  aspApiKey       String?       @db.NVarChar(500)
  isActive        Boolean       @default(true)
  /** Next hub Peppol invoice number (inv-N); incremented on each create. */
  invoiceSequence Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  integrations    Integration[]
  invoices        Invoice[]
  legalEntities   LegalEntity[]
  aspConnections  AspConnection[]

  @@map("tenants")
}

model Integration {
  id              String    @id @default(uuid()) @db.NVarChar(250)
  tenantId        String    @db.NVarChar(250)
  code            String    @db.NVarChar(100)
  name            String    @db.NVarChar(200)
  authType        String    @default("API_KEY_HMAC") @db.NVarChar(50)
  apiKey          String    @db.NVarChar(200)
  apiSecret       String    @db.NVarChar(500)
  /** Optional default legal entity for this integration. */
  legalEntityId   String?   @db.NVarChar(250)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  legalEntity     LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices        Invoice[]

  @@unique([tenantId, code])
  @@map("integrations")
}

model LegalEntity {
  id           String          @id @default(uuid()) @db.NVarChar(250)
  tenantId     String          @db.NVarChar(250)
  code         String          @db.NVarChar(100)
  name         String          @db.NVarChar(200)
  trn          String?         @db.NVarChar(50)
  email        String?         @db.NVarChar(200)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  integrations Integration[]
  aspConnections AspConnection[]
  invoices     Invoice[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("legal_entities")
}

/** ASP Provider Master — no customer credentials. */
model AspProvider {
  id                     String                @id @default(uuid()) @db.NVarChar(250)
  code                   String                @unique @db.NVarChar(50)
  name                   String                @db.NVarChar(200)
  status                 String                @default("INACTIVE") @db.NVarChar(20)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  apiConfigs             AspProviderApiConfig[]
  connections            AspConnection[]

  @@map("asp_providers")
}

/** ASP API endpoint config per environment (paths used by adapters). */
model AspProviderApiConfig {
  id                String      @id @default(uuid()) @db.NVarChar(250)
  aspProviderId     String      @db.NVarChar(250)
  environment       String      @db.NVarChar(20)
  baseUrl           String?     @db.NVarChar(500)
  loginPath         String?     @db.NVarChar(500)
  invoiceSubmitPath String?     @db.NVarChar(500)
  statusPath        String?     @db.NVarChar(500)
  timeoutMs         Int         @default(30000)
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  aspProvider       AspProvider @relation(fields: [aspProviderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([aspProviderId, environment])
  @@map("asp_provider_api_configs")
}

/**
 * ASP connection for a legal entity.
 * Business rule: at most one ACTIVE connection per (legalEntityId, environment).
 */
model AspConnection {
  id               String          @id @default(uuid()) @db.NVarChar(250)
  tenantId         String          @db.NVarChar(250)
  legalEntityId    String          @db.NVarChar(250)
  aspProviderId    String          @db.NVarChar(250)
  environment      String          @db.NVarChar(20)
  status           String          @default("INACTIVE") @db.NVarChar(20)
  lastTestAt       DateTime?
  lastTestStatus   String?         @db.NVarChar(50)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  legalEntity      LegalEntity     @relation(fields: [legalEntityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  aspProvider      AspProvider     @relation(fields: [aspProviderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  credentials      AspCredential[]
  invoices         Invoice[]

  @@index([tenantId, status])
  @@index([legalEntityId, environment, status])
  @@map("asp_connections")
}

model AspCredential {
  id              String        @id @default(uuid()) @db.NVarChar(250)
  aspConnectionId String        @db.NVarChar(250)
  key             String        @db.NVarChar(100)
  valueEncrypted  String        @db.NVarChar(Max)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  aspConnection   AspConnection @relation(fields: [aspConnectionId], references: [id], onDelete: Cascade)

  @@unique([aspConnectionId, key])
  @@map("asp_credentials")
}

model Invoice {
  /** Hub numeric primary key (auto-increment). */
  id                   Int            @id @default(autoincrement())
  tenantId             String         @db.NVarChar(250)
  integrationId        String         @db.NVarChar(250)
  legalEntityId        String?        @db.NVarChar(250)
  aspConnectionId      String?        @db.NVarChar(250)
  sourceSystem         String         @db.NVarChar(100)
  sourceDocumentId     String         @db.NVarChar(100)
  idempotencyKey       String         @db.NVarChar(200)
  /** Hub-generated Peppol cbc:ID, e.g. inv-1, inv-2, … */
  invoiceNumber        String         @db.NVarChar(100)
  /** Source-system document / DCNote number (IBMS), e.g. 119 */
  sourceSystemDCNoteId String?        @db.NVarChar(100)
  documentType         String         @db.NVarChar(50)
  /** Hub-facing status (backward-compatible public API). */
  status               String         @default("DRAFT") @db.NVarChar(50)
  /** Layered internal statuses (provider-independent). */
  hubProcessingStatus  String?        @db.NVarChar(50)
  aspSubmissionStatus  String?        @db.NVarChar(50)
  peppolDeliveryStatus String?        @db.NVarChar(50)
  taxReportingStatus   String?        @db.NVarChar(50)
  providerStatusRaw    String?        @db.NVarChar(100)
  providerResponseCode String?        @db.NVarChar(50)
  providerErrorMessage String?        @db.NVarChar(2000)
  issueDate            DateTime
  currencyCode         String         @default("AED") @db.NVarChar(3)
  sellerName           String         @db.NVarChar(200)
  sellerTrn            String?        @db.NVarChar(50)
  sellerAddressLine1   String?        @db.NVarChar(200)
  sellerAddressLine2   String?        @db.NVarChar(200)
  sellerCity           String?        @db.NVarChar(100)
  sellerState          String?        @db.NVarChar(100)
  sellerPostalCode     String?        @db.NVarChar(50)
  sellerCountryCode    String         @default("AE") @db.NVarChar(100)
  buyerName            String         @db.NVarChar(200)
  buyerTrn             String?        @db.NVarChar(50)
  buyerAddressLine1    String?        @db.NVarChar(200)
  buyerAddressLine2    String?        @db.NVarChar(200)
  buyerCity            String?        @db.NVarChar(100)
  buyerState           String?        @db.NVarChar(100)
  buyerPostalCode      String?        @db.NVarChar(50)
  buyerCountryCode     String         @default("AE") @db.NVarChar(100)
  subtotalAmount       Decimal        @db.Decimal(18, 2)
  taxAmount            Decimal        @db.Decimal(18, 2)
  totalAmount          Decimal        @db.Decimal(18, 2)
  notes                String?        @db.NVarChar(1000)
  aspMessageId         String?        @db.NVarChar(100)
  aspReferenceId       String?        @db.NVarChar(100)
  aspPayload           String?        @db.NVarChar(Max)
  aspResponse          String?        @db.NVarChar(Max)
  submissionAttempts   Int            @default(0)
  lastSubmissionError  String?        @db.NVarChar(2000)
  lastSubmissionAt     DateTime?
  rejectionReason      String?        @db.NVarChar(2000)
  submittedAt          DateTime?
  acceptedAt           DateTime?
  rejectedAt           DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  integration          Integration    @relation(fields: [integrationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  legalEntity          LegalEntity?   @relation(fields: [legalEntityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  aspConnection        AspConnection? @relation(fields: [aspConnectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines                InvoiceLine[]
  events               InvoiceEvent[]

  @@unique([tenantId, sourceSystem, sourceDocumentId, documentType])
  @@unique([tenantId, integrationId, idempotencyKey])
  @@unique([tenantId, invoiceNumber, documentType])
  @@index([tenantId, status])
  @@index([integrationId, sourceDocumentId])
  @@index([legalEntityId, status])
  @@map("invoices")
}

model InvoiceLine {
  id          String   @id @default(uuid()) @db.NVarChar(250)
  invoiceId   Int
  lineNumber  Int
  description String   @db.NVarChar(500)
  quantity    Decimal  @db.Decimal(18, 4)
  unitPrice   Decimal  @db.Decimal(18, 2)
  netAmount   Decimal  @db.Decimal(18, 2)
  vatRate     Decimal  @db.Decimal(5, 2)
  vatCategory String   @db.NVarChar(20)
  taxAmount   Decimal  @db.Decimal(18, 2)
  totalAmount Decimal  @db.Decimal(18, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, lineNumber])
  @@map("invoice_lines")
}

model InvoiceEvent {
  id         String   @id @default(uuid()) @db.NVarChar(250)
  invoiceId  Int
  type       String   @db.NVarChar(50)
  fromStatus String?  @db.NVarChar(50)
  toStatus   String?  @db.NVarChar(50)
  message    String   @db.NVarChar(1000)
  payload    String?  @db.NVarChar(Max)
  createdAt  DateTime @default(now())
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
  @@map("invoice_events")
}
